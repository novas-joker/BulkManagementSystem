# MailForge local environment template
# Copy this file to .env and replace placeholder values with real local credentials.
# Keep this file committed; keep .env uncommitted.

# App
APP_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database / Redis
DATABASE_URL=postgresql+asyncpg://mailforge:mailforge_password@localhost:5432/mailforge_db
SYNC_DATABASE_URL=postgresql+psycopg://mailforge:mailforge_password@localhost:5432/mailforge_db
REDIS_URL=redis://localhost:6379/0

# JWT / Security
JWT_SECRET=local-dev-jwt-secret-change-later
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ZeptoMail
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_SEND_MAIL_TOKEN=your-zeptomail-token
ZEPTOMAIL_FROM_EMAIL=no-reply@example.com
ZEPTOMAIL_MOCK=true

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password

# Zoho Campaigns
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_CAMPAIGNS_API_URL=https://campaigns.zoho.com/api/v1.1
ZOHO_CAMPAIGNS_MOCK=true
